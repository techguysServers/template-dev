# syntax=docker/dockerfile:1
# Python (FastAPI / Django) avec uv (gestionnaire moderne, rapide).
# Multi-stage, non-root, slim.
#
# ⚠️ Vérifie la dernière version Python sur https://hub.docker.com/_/python
#    et la dernière image uv sur https://github.com/astral-sh/uv

# ── build : installe les deps avec uv ────────────────────────────────────────
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock* ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev

# ── runtime ──────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime
WORKDIR /app
RUN useradd --system --uid 1001 appuser
COPY --from=build --chown=appuser /app /app
ENV PATH="/app/.venv/bin:$PATH"
USER appuser
EXPOSE 8000
# FastAPI : uvicorn. Django : gunicorn config.wsgi
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
