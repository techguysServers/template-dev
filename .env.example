# Copie en .env.local (front) ou .env (compose). Jamais commité (gitleaks veille).
# Remplis selon les briques activées. Valeurs vides = à compléter.

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=my-project

# ── Base de données (Postgres / pgvector) ──────────────────────────────────────
DATABASE_URL=postgresql://app:app@localhost:5432/app
# Variables utilisées par docker/docker-compose.yml
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# ── Cache / queues (Redis) ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────────────────────────
# Clerk (défaut SaaS)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# CLERK_SECRET_KEY=sk_test_xxx
# Keycloak (self-hosted / SSO) — voir docker-compose
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
# KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/my-realm

# ── Sécurité / API ───────────────────────────────────────────────────────────────
# ARCJET_KEY=ajkey_xxx
# ALLOWED_ORIGINS=http://localhost:3000

# ── Observabilité ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
# AXIOM_TOKEN=xaat-xxx

# ── IA / Embeddings (pgvector) ───────────────────────────────────────────────────
# OPENAI_API_KEY=sk-xxx

# ── Email (dev → Mailpit) ─────────────────────────────────────────────────────────
# SMTP_HOST=localhost
# SMTP_PORT=1025
# RESEND_API_KEY=re_xxx
